# Backend base URL — shared backend over Tailscale (MagicDNS name, stable).
# Remote devs on the Uniplexity tailnet connect automatically — no per-dev setup.
# To point at a different backend, override in .env.local (gitignored).
VITE_API_BASE_URL=http://22.84.115.25:8080

# Default snapshot (as-of) date shown by the portfolio/customer views.
# Overridable at runtime via the header date selector (persisted in localStorage).
VITE_AS_OF_DATE=2026-07-27